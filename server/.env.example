NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://localhost:5432/safelygo
# Set true only if your Postgres connection requires TLS. Certificates are verified.
DATABASE_SSL=false
# Comma-separated web origins. Native apps are not subject to CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
PUBLIC_URL=http://localhost:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SafelyGo <noreply@your-domain.example>
# Development only: deliver mail to server/.mail instead of SMTP.
MAIL_MODE=file
# Optional public web app origin for invitation links, e.g. https://app.your-domain.example
PUBLIC_APP_URL=
# Published registration assistance address. Use a monitored real inbox in production.
PLATFORM_SUPPORT_EMAIL=
# Verified account emails explicitly authorized to review every campus. Empty disables the operator UI.
PLATFORM_OPERATOR_EMAILS=
# Self-hosted or contracted Nominatim-compatible search endpoint; never a user-provided URL.
GEOCODER_SEARCH_URL=

# Recommended on Railway Free/Hobby: HTTPS email delivery
# Set MAIL_MODE=resend, verify a sending domain, then configure:
RESEND_API_KEY=
MAIL_FROM=
PLATFORM_OPERATOR_NAME=
