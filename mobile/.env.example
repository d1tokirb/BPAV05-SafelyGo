# Device must be able to reach this URL. Use your computer's LAN IP for local devices.
EXPO_PUBLIC_API_URL=http://localhost:4000
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional EAS project UUID after running eas init.
EAS_PROJECT_ID=

# Optional browser-only override when native devices use a different reachable API URL.
# EXPO_PUBLIC_WEB_API_URL=http://localhost:4000
